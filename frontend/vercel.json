{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://finertia-api-zobr7nkp7a-el.a.run.app/api/:path*" },
    { "source": "/demo", "destination": "/demo.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/writeup", "destination": "/writeup.html" },
    { "source": "/strategies", "destination": "/strategies.html" },
    { "source": "/strategies/momentum", "destination": "/strategy-momentum.html" },
    { "source": "/strategies/macd", "destination": "/strategy-macd.html" },
    { "source": "/strategies/bollinger", "destination": "/strategy-bollinger.html" },
    { "source": "/learn", "destination": "/learn.html" },
    { "source": "/learn/walk-forward-validation", "destination": "/learn-walk-forward-validation.html" },
    { "source": "/learn/backtest-overfitting", "destination": "/learn-backtest-overfitting.html" },
    { "source": "/learn/lookahead-bias", "destination": "/learn-lookahead-bias.html" },
    { "source": "/learn/sharpe-ratio", "destination": "/learn-sharpe-ratio.html" },
    { "source": "/learn/permutation-test", "destination": "/learn-permutation-test.html" },
    { "source": "/stocks", "destination": "/stocks.html" },
    { "source": "/stocks/aapl", "destination": "/stock-aapl.html" },
    { "source": "/stocks/msft", "destination": "/stock-msft.html" },
    { "source": "/stocks/nvda", "destination": "/stock-nvda.html" },
    { "source": "/stocks/amzn", "destination": "/stock-amzn.html" },
    { "source": "/stocks/googl", "destination": "/stock-googl.html" },
    { "source": "/stocks/meta", "destination": "/stock-meta.html" },
    { "source": "/stocks/tsla", "destination": "/stock-tsla.html" },
    { "source": "/stocks/jpm", "destination": "/stock-jpm.html" },
    { "source": "/stocks/spy", "destination": "/stock-spy.html" },
    { "source": "/stocks/qqq", "destination": "/stock-qqq.html" },
    { "source": "/stocks/reliance", "destination": "/stock-reliance.html" },
    { "source": "/stocks/tcs", "destination": "/stock-tcs.html" },
    { "source": "/stocks/hdfcbank", "destination": "/stock-hdfcbank.html" },
    { "source": "/stocks/infy", "destination": "/stock-infy.html" },
    { "source": "/stocks/icicibank", "destination": "/stock-icicibank.html" },
    { "source": "/stocks/nifty-50", "destination": "/stock-nifty-50.html" },
    { "source": "/((?!assets/|api/).*)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
