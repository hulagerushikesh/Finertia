# ─── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=http://localhost:8000
# Shown on /support and used for its mailto link. Unset falls back to an
# obviously-fake placeholder rather than a plausible wrong address.
VITE_SUPPORT_EMAIL=

# ─── Backend ───────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Must match the frontend origin exactly. Local dev is pinned to 5174 in
# frontend/vite.config.js; add your Firebase Hosting URL for production.
ALLOWED_ORIGINS=http://localhost:5174,https://your-app.web.app

# ─── Backend: operational (all optional, defaults shown) ───────────────────────
# DEBUG makes local failures verbose; leave at INFO in production so the logs
# stay readable and cheap.
LOG_LEVEL=INFO

# Rate limits, per 60-second sliding window. The IP limit is the blunt guard
# against an unauthenticated flood. The other two are per user account, because
# a backtest fetches market data and a validation run sweeps a parameter grid
# hundreds of times — those are metered per account, not per address, so an
# office behind one NAT does not share a budget.
RATE_LIMIT_IP_PER_MIN=120
RATE_LIMIT_BACKTEST_PER_MIN=20
RATE_LIMIT_VALIDATE_PER_MIN=5

# ─── Optional: billing (Stripe) ───────────────────────────────────────────────
# Leave these unset to run without billing. The pricing page still renders, the
# upgrade button explains billing is not enabled, and quotas still apply — every
# account simply stays on the free plan. Requires `pip install stripe`.
#
# STRIPE_WEBHOOK_SECRET is what authenticates the webhook: that endpoint cannot
# require a Firebase token, so the signature is the only thing standing between
# a stranger and a free upgrade. Never deploy the webhook without it.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Optional: error tracking (Sentry) ────────────────────────────────────────
# Unset means no-op and the SDK is never imported. Requires `pip install sentry-sdk`.
# SENTRY_DSN=https://...@...ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
